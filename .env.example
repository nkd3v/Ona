# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# The log channel is not set here: a server admin runs /logchannel set in Discord.
# Folder where the bot saves each server's chosen log channel.
DATA_DIR=data

# Number of recent messages kept in memory across all visible channels.
MESSAGE_CACHE_SIZE=10000

# --- Scam filter ---
# What to do to the poster after their scam message is deleted: none, timeout, kick or ban.
SCAM_ACTION=timeout
# Timeout length in minutes (max 40320 = 28 days).
SCAM_TIMEOUT_MINUTES=1440
# Comma-separated domains whose links are deleted. Subdomains are included.
BLOCKED_DOMAINS=wispwin.com,fapwin.com
# Folder of extra scam example images.
SCAM_IMAGES_DIR=scam-images
# Delete a post with files or links once one person posts it in this many channels
# within 2 minutes (0 turns it off).
SPAM_REPEAT_CHANNELS=3
# How different an image may be from a known scam image and still match (0-100).
SCAM_IMAGE_MATCH_DISTANCE=40
# Free key from https://ocr.space/ocrapi to read text in images. Leave empty to turn off.
OCR_SPACE_API_KEY=
# Comma-separated words that make an image a scam when they appear in its text.
SCAM_IMAGE_WORDS=mrbeast,crypto,casino
